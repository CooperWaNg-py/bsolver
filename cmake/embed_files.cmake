# Invoked as: cmake -DOUTPUT= -DSYMBOL= -DMODE=binary|text [-DDIR=] [-DFILES=a|b|c] -P embed_files.cmake

function(hex_bytes path out_var)
  file(READ "${path}" hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  set(${out_var} "${hex}" PARENT_SCOPE)
endfunction()

function(mime_for path out_var)
  string(TOLOWER "${path}" p)
  if(p MATCHES "\\.html$")
    set(m "text/html; charset=utf-8")
  elseif(p MATCHES "\\.js$")
    set(m "text/javascript")
  elseif(p MATCHES "\\.css$")
    set(m "text/css")
  elseif(p MATCHES "\\.svg$")
    set(m "image/svg+xml")
  elseif(p MATCHES "\\.json$")
    set(m "application/json")
  elseif(p MATCHES "\\.png$")
    set(m "image/png")
  elseif(p MATCHES "\\.ico$")
    set(m "image/x-icon")
  elseif(p MATCHES "\\.woff2$")
    set(m "font/woff2")
  else()
    set(m "application/octet-stream")
  endif()
  set(${out_var} "${m}" PARENT_SCOPE)
endfunction()

set(header "// Generated by cmake/embed_files.cmake. Do not edit.\n#include \"assets/assets.h\"\n\nnamespace bsolver::assets {\n")

if(MODE STREQUAL "text")
  string(REPLACE "|" ";" files "${FILES}")
  set(body "")
  foreach(f IN LISTS files)
    hex_bytes("${f}" bytes)
    string(APPEND body "${bytes}")
  endforeach()
  set(content "${header}namespace {\nconst unsigned char k${SYMBOL}Data[] = {${body}0x00};\n}\n")
  string(APPEND content "extern const std::string_view k${SYMBOL}(reinterpret_cast<const char*>(k${SYMBOL}Data), sizeof(k${SYMBOL}Data) - 1);\n}\n")
elseif(MODE STREQUAL "binary")
  set(entries "")
  set(arrays "")
  set(count 0)
  if(DIR)
    file(GLOB_RECURSE files LIST_DIRECTORIES false RELATIVE "${DIR}" "${DIR}/*")
    list(SORT files)
    foreach(rel IN LISTS files)
      hex_bytes("${DIR}/${rel}" bytes)
      file(SIZE "${DIR}/${rel}" size)
      mime_for("${rel}" mime)
      string(APPEND arrays "const unsigned char d${count}[] = {${bytes}0x00};\n")
      string(APPEND entries "  {\"/${rel}\", \"${mime}\", d${count}, ${size}},\n")
      math(EXPR count "${count} + 1")
    endforeach()
  endif()
  if(count EQUAL 0)
    set(entries "  {\"\", \"\", nullptr, 0},\n")
  endif()
  set(content "${header}namespace {\n${arrays}}\n")
  string(APPEND content "extern const Asset k${SYMBOL}[] = {\n${entries}};\nextern const size_t k${SYMBOL}Count = ${count};\n}\n")
else()
  message(FATAL_ERROR "embed_files: unknown MODE '${MODE}'")
endif()

# Only touch the output when it changes to avoid needless rebuilds.
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" old)
  if(old STREQUAL content)
    return()
  endif()
endif()
file(WRITE "${OUTPUT}" "${content}")
